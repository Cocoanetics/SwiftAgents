# Copy to `.env` and fill in your keys. `.env` is gitignored.
OPENAI_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
OLLAMA_URL=http://localhost:11434
LMSTUDIO_URL=
# Optional model pins for the LM Studio live tests:
LMSTUDIO_MODEL=
LMSTUDIO_EMBED_MODEL=
LMSTUDIO_VISION_MODEL=
# Generic OpenAI-compatible local server for the embedding live tests:
LOCAL_LLM_URL=
# Set to 1 to opt into the live Ollama chat suites (needs a reachable OLLAMA_URL):
RUN_OLLAMA_TESTS=
# Set to 1 to opt into live tests that mutate hosted OpenAI state
# (vector stores, conversations — in addition to OPENAI_API_KEY):
LIVE_STATE_TESTS=
