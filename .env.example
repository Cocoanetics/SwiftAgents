# Copy to `.env` and fill in your keys. `.env` is gitignored.
OPENAI_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
OLLAMA_URL=http://localhost:11434
LMSTUDIO_URL=
# Optional model pins for the LM Studio live tests:
LMSTUDIO_MODEL=
LMSTUDIO_EMBED_MODEL=
LMSTUDIO_VISION_MODEL=
# Opt-in for live tests that mutate hosted OpenAI vector-store state
# (in addition to OPENAI_API_KEY). Leave unset to skip them.
LIVE_STATE_TESTS=
